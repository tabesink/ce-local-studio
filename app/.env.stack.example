# Copy to .env.stack.local or pass these values through your shell.
# Do not commit .env.stack.local or any working secret values.
#
# Hard-cut rename: former .env.p10.local is not read. Recreate from this example.
# Volume rename (stack-postgres-data) starts a fresh local database unless you migrate data manually.

POSTGRES_DB=<set locally>
POSTGRES_USER=<set locally>
POSTGRES_PASSWORD=<set locally>

# Host-native scripts/dev.sh only. Compose uses the internal postgres service.
# Set these when Postgres is published to the host (for example 127.0.0.1:5438).
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432

CE_ADMIN_USERNAME=<set locally>
CE_ADMIN_PASSWORD=<set locally>

# Local HTTP smoke requires the session cookie to be sent over http://127.0.0.1.
CE_SESSION_COOKIE_SECURE=false

# Local Compose/host-native loops keep testing mode until the same-origin BFF
# supplies trusted peer/public-origin headers (P9-05/P10). Production must set
# CONTEXT_ENGINE_TESTING=false and the four CE_* ingress settings below.
CONTEXT_ENGINE_TESTING=true

# Required when CONTEXT_ENGINE_TESTING=false (production/staging ingress):
# CE_PUBLIC_ORIGIN=https://ce.example.com
# CE_INTERNAL_HOSTS=api
# CE_TRUSTED_BFF_PEERS=10.0.0.0/8
# CE_CSRF_SIGNING_KEY=<dedicated high-entropy key, not CONFIG_ENCRYPTION_KEY>
# CE_SESSION_IDLE_TTL_SECONDS=1800
# CE_SESSION_TOUCH_INTERVAL_SECONDS=60
# CE_LOGIN_THROTTLE_WINDOW_SECONDS=300
# CE_LOGIN_THROTTLE_MAX_FAILURES=5
# CE_LOGIN_THROTTLE_BLOCK_SECONDS=900

# Fernet key generated locally, for example:
# python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
CONFIG_ENCRYPTION_KEY=<set locally>

# Used by host-native scripts/dev.sh. Compose frontend hardcodes http://api:8000.
CONTEXT_ENGINE_API_BASE=http://127.0.0.1:8000

STACK_API_PORT=8000
STACK_FRONTEND_PORT=3000

# Optional: idle sleep between empty worker poll rounds (seconds).
# CE_WORKER_IDLE_SECONDS=2

# Optional: per-Knowledge Graph soft storage limit shown in Settings storage bars.
# Default is 5 GiB.
# CE_DOMAIN_STORAGE_LIMIT_BYTES=5368709120

# --- Optional live Docker LightRAG overlay (NOT the default F-010 gate) ---
# Requires: Docker daemon, provider credentials, and a host-visible absolute path
# that is bind-mounted identically into api/worker for controller sibling binds.
# Example:
#   CE_STACK_LIVE_RUNTIME_ROOT=/home/you/.local/share/context-engine/stack-domain-runtimes
# Then:
#   docker compose --env-file .env.stack.local -f compose.stack.yml -f compose.stack.live.yml up --build -d
#   python scripts/stack_smoke_live.py --env-file .env.stack.local ...
# Live image installs Docker CLI + .[lightrag-runtime]. Socket mount is local
# single-operator only — never production / shared multi-tenant.
# CE_STACK_LIVE_RUNTIME_ROOT=<absolute host path>
